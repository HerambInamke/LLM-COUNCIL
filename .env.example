# Required: Your OpenRouter API Key (get one at openrouter.ai)
OPENROUTER_API_KEY="sk-or-v1-..."

# Optional: Set a password to protect the UI
INITIAL_PASSWORD="your_secure_password"

# Optional: Override the default council models (comma-separated list of model slugs)
# COUNCIL_MODELS="google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,nvidia/nemotron-3.5-lightning:free"

# Optional: Override the default chairman model
# CHAIRMAN_MODEL="liquid/lfm-2.5-2.6b:free"
